---
/**
 * The hero: name set large, the cut-out portrait standing in front of the end of the surname,
 * a soft warm "window light" behind the portrait, and the key facts a visitor needs in 10 seconds.
 *
 * Desktop: role, intro and actions sit top-left; the name runs along the bottom like a masthead,
 * and the portrait's shoulder covers the tail of the surname. Mobile: name, portrait, then copy.
 *
 * Portrait: the first of src/assets/portrait.{png,webp,avif} is used. Remove the file and a quiet
 * placeholder takes its place. It's height-driven and bottom-anchored, so a taller seated photo fits too.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../config/site';
import Button from './Button.astro';
import Availability from './Availability.astro';
import Placeholder from './Placeholder.astro';

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{png,webp,avif}', { eager: true });
const portrait = Object.values(found)[0]?.default;
---

<section class="hero" aria-labelledby="hero-name">
  <div class="wrap stage">
    <div class="light" aria-hidden="true"></div>

    <p class="meta label muted">
      <span><span class="num">(00)</span> Index</span>
      <span>Portfolio {new Date().getFullYear()}</span>
    </p>

    <h1 class="name display" id="hero-name">
      <span class="line"><span class="rise">{site.firstName}</span></span>
      <span class="line"><span class="rise"><em>{site.lastName}</em></span></span>
    </h1>

    <div class:list={['portrait', { mirror: site.portrait.mirror }]}>
      {
        portrait ? (
          <Picture
            src={portrait}
            alt={site.portrait.alt}
            formats={['avif', 'webp']}
            widths={[480, 720, 960, 1280, 1600]}
            sizes="(min-width: 64rem) 52vw, 80vw"
            loading="eager"
            fetchpriority="high"
            class="portrait-img"
          />
        ) : (
          <div class="portrait-empty">
            <Placeholder what="Portrait: add src/assets/portrait.png" />
          </div>
        )
      }
    </div>

    <div class="copy">
      <p class="role">
        <span class="role-title">{site.role}</span>
        <span class="role-focus">{site.roleFocus}</span>
      </p>
      <p class="intro">{site.intro}</p>

      <div class="actions">
        <Button href="#contact">Hire me</Button>
        <Button href="#work" variant="text" arrow="↓">See the work</Button>
      </div>

      <Availability />

    </div>
  </div>

  <div class="wrap">
    <div class="strip label">
      <ul class="links" role="list" aria-label="Profiles">
        {
          site.links.map((link) => (
            <li>
              {link.href ? (
                <a href={link.href} rel="me noopener" target="_blank">
                  {link.label}
                  <span aria-hidden="true">↗</span>
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              ) : (
                <Placeholder what={`${link.label} URL`} />
              )}
            </li>
          ))
        }
        <li><a href={`mailto:${site.email}`}>Email</a></li>
      </ul>
      <p class="where muted">
        <span>{site.location}</span>
        <span>
          {site.timezone.offset} · <time class="clock" data-tz={site.timezone.iana}>--:--</time>{' '}{site.timezone.label}
        </span>
      </p>
    </div>
  </div>
</section>

<script>
  // Live local time in Addis Ababa, so visitors can see the time-zone overlap at a glance.
  document.querySelectorAll<HTMLTimeElement>('time.clock').forEach((el) => {
    const format = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: el.dataset.tz });
    const tick = () => {
      const now = new Date();
      el.textContent = format.format(now);
      el.dateTime = now.toISOString();
    };
    tick();
    setInterval(tick, 20_000);
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: clip;
    border-bottom: var(--rule);
  }

  /* Mobile / tablet: a single column in reading order. */
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'meta'
      'name'
      'port'
      'copy';
  }

  .meta {
    grid-area: meta;
    display: flex;
    justify-content: space-between;
    padding-top: var(--space-m);
    position: relative;
    z-index: 3;
  }

  .num {
    color: var(--accent-text);
    margin-right: 0.9em;
  }

  /* Window light: one broad, low-chroma ellipse that fades out completely before its box edge,
     so there are no hard lines. Sits behind everything. */
  .light {
    position: absolute;
    z-index: 0;
    inset: 0 calc(var(--gutter) * -1);
    background: radial-gradient(ellipse 75% 45% at 62% 52%, var(--window-light) 0%, var(--window-light-edge) 100%);
    pointer-events: none;
  }

  .name {
    grid-area: name;
    position: relative;
    z-index: 1;
    font-size: var(--step-6);
    margin-top: var(--space-l);
  }

  .line {
    display: block;
    overflow: clip;
    /* Room for descenders and the italic overhang inside the clip. */
    padding: 0 0.08em 0.08em 0;
    margin-bottom: -0.08em;
  }

  .rise {
    display: inline-block;
  }

  .portrait {
    grid-area: port;
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    /* A slight tuck: the hair just meets the surname's baseline without hiding letters. */
    margin-top: calc(var(--step-6) * -0.12);
    margin-right: calc(var(--gutter) * -1);
    pointer-events: none;
  }

  .portrait :global(.portrait-img) {
    width: min(82%, 24rem);
    height: auto;
  }

  .mirror :global(.portrait-img) {
    transform: scaleX(-1);
  }

  .portrait-empty {
    display: grid;
    place-items: end start;
    width: min(82%, 24rem);
    aspect-ratio: 4 / 5;
    padding: var(--space-s);
    border: 1px dashed var(--line-strong);
    background: var(--surface);
  }

  .copy {
    grid-area: copy;
    position: relative;
    z-index: 3;
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    padding-block: var(--space-l) var(--space-xl);
    border-top: var(--rule);
  }

  .role {
    display: grid;
    gap: 0.15em;
    font-size: var(--step-1);
    line-height: var(--leading-tight);
  }

  .role-title {
    font-weight: 500;
  }

  .role-focus {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.12em;
    color: var(--muted);
  }

  .intro {
    max-width: 38ch;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-l);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
  }

  .links a {
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .links a span[aria-hidden] {
    margin-left: 0.3em;
    color: var(--muted);
  }

  .strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-xs) var(--space-l);
    padding-block: var(--space-xs);
    border-top: 1px solid var(--ink);
  }

  .where {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-m);
  }

  .clock {
    color: var(--ink);
  }

  /* Desktop: copy top-left, name along the bottom, portrait standing on the bottom rule
     with its shoulder in front of the end of the surname. */
  @media (min-width: 64rem) {
    .stage {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      grid-template-rows: auto auto 1fr auto;
      grid-template-areas:
        'meta meta meta meta meta meta meta meta meta meta meta meta'
        'copy copy copy copy copy copy . . . . . .'
        '. . . . . . . . . . . .'
        'name name name name name name name name name name name name';
      /* Height comes from the content, not the viewport, so there's no dead band of space. */
      /* Name size shared by the name and the portrait's position. The svh term keeps
         the whole name above the fold on short laptop screens (1366×768). */
      --name-size: min(var(--step-6), 9rem, 17svh);
    }

    .light {
      background:
        radial-gradient(ellipse 42% 62% at 66% 50%, var(--window-light) 0%, var(--window-light-edge) 100%),
        radial-gradient(ellipse 30% 40% at 52% 22%, var(--window-light) 0%, var(--window-light-edge) 100%);
    }

    .copy {
      border-top: 0;
      gap: var(--space-s);
      padding-block: var(--space-l);
    }

    .actions {
      margin-block: var(--space-2xs);
    }

    .name {
      margin-top: var(--space-m);
      padding-bottom: var(--space-xs);
      font-size: var(--name-size);
    }

    /* Anchored to the name, not the grid: "Zeselassie" is 3.7em wide in Newsreader italic,
       so starting the portrait at 3.45em puts the shoulder over about half of the final letter
       at every desktop width. Re-measure if the display font changes. */
    .portrait {
      position: absolute;
      z-index: 2;
      left: calc(var(--gutter) + var(--name-size) * 3.45);
      bottom: 0;
      height: calc(100% - var(--space-l));
      margin: 0;
      /* Clip at the bottom rule so the scroll drift sinks the portrait behind the line
         instead of pushing it past it. The negative insets leave the top and sides free. */
      clip-path: inset(-100vh -100vw 0 -100vw);
    }

    .portrait :global(picture) {
      height: 100%;
    }

    .portrait :global(.portrait-img) {
      width: auto;
      height: 100%;
      max-width: none;
    }

    .portrait-empty {
      width: auto;
      height: 85%;
      align-self: flex-end;
    }
  }

  /* Load choreography: name lines rise out of their clip, portrait settles, the rest follows.
     Everything ends within ~1.1s; base.css cancels it under prefers-reduced-motion. */
  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise var(--dur-slow) var(--ease-out) 150ms both;
    }

    .line:nth-child(2) .rise {
      animation-delay: 240ms;
    }

    .portrait {
      animation: settle 1100ms var(--ease-out) 60ms both;
    }

    .light {
      animation: fade 1400ms ease both;
    }

    .copy,
    .meta {
      animation: fade 700ms ease 450ms both;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  /* The one scroll-linked moment: the portrait sinks slightly as the hero scrolls away,
     so it reads as a layer behind the page. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 64rem) {
      .portrait :global(picture) {
        animation: drift linear both;
      }

      /* Kept in a separate, more specific rule: the CSS minifier otherwise folds the timeline
         into the `animation` shorthand, which can't carry it, and the browser drops the lot. */
      .stage .portrait :global(picture) {
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }

  @keyframes drift {
    to {
      transform: translateY(8%);
    }
  }
</style>
