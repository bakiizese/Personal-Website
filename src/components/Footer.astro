---
import { site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap row">
    <p class="label muted">© {year} {site.name}</p>
    <p class="label muted">{site.location} · {site.timezone.offset}</p>
    <p class="label muted colophon">Set in Instrument Serif, Geist &amp; Geist Mono. Built with Astro.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    border-top: var(--rule);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-l);
    padding-block: var(--space-m);
  }
</style>
