---
import { site } from '../config/site';
import Availability from './Availability.astro';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="name" href="/">
      <span class="full">{site.name}</span>
      <span class="short" aria-hidden="true">{site.monogram}</span>
    </a>

    <nav aria-label="Main">
      <ul role="list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="end">
      <span class="status"><Availability compact /></span>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 4rem;
  }

  .name {
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .short {
    display: none;
    font-family: var(--serif);
    font-size: 1.5rem;
    line-height: 1;
  }

  nav ul {
    display: flex;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }

  nav a {
    font-size: var(--step--1);
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .end {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  @media (max-width: 47.99rem) {
    .status {
      display: none;
    }

    /* The full name stays as the link's accessible name; the monogram is decorative. */
    .full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .short {
      display: inline;
    }
  }
</style>
